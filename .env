# ── AI Configuration ───────────────────────────────────────────────────────────
# Set USE_GOOGLE_AI=true to enable the dual Gemma 4 setup (hackathon mode):
#   Chatbot      → Google AI Studio cloud  (gemma-4-26b-a4b-it, streaming)
#   Intelligence → Ollama local on-device  (gemma4, runs offline)
USE_GOOGLE_AI=true

# Google AI Studio — chatbot provider
# Get a free key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIzaSyBQhIKd6mnfPwd5DKRBLLcR_-rf_OQXJdA

# Gemma 4 model IDs for Google AI Studio:
#   gemma-4-26b-a4b-it   MoE 4B active / 26B total, 256K context  (default, efficient)
#   gemma-4-31b-it       31B dense, 256K context                   (highest quality)
GOOGLE_AI_MODEL=gemma-4-26b-a4b-it


# Local Ollama
OLLAMA_ENABLED=true
 
# Ollama local — intelligence provider (task/notification/summary prompts)
# Install: https://ollama.com/download  then: ollama pull gemma4
OLLAMA_HOST=http://localhost:11434

# Gemma 4 Ollama tags:
#   gemma4          pulls e4b (9.6 GB) — default, best quality/size balance
#   gemma4:e2b      7.2 GB — lighter, faster on low-RAM machines
#   gemma4:26b      18 GB  — MoE, highest quality
OLLAMA_MODEL=gemma4:e2b



