# Copy this file to .env and fill in your own values. Never commit .env.
SECRET_KEY=change-me
DATABASE_URL=sqlite:///app.db

# Google AI Studio (chatbot). Get a key at https://aistudio.google.com/apikey
USE_GOOGLE_AI=true
GOOGLE_API_KEY=
GOOGLE_AI_MODEL=gemma-4-26b-a4b-it

# Local Ollama (background intelligence). Set to false where Ollama isn't available (e.g. Render).
OLLAMA_ENABLED=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4

# Demo clock: run the app on a simulated date, e.g. DEMO_TODAY=2027-05-05 (Kharif season,
# which the rule base covers). Leave empty to use the real date.
DEMO_TODAY=
