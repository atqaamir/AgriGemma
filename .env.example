# Copy this file to .env and fill in your own values. Never commit .env.
SECRET_KEY=change-me
DATABASE_URL=sqlite:///app.db

# Google AI Studio (chatbot). Get a key at https://aistudio.google.com/apikey
USE_GOOGLE_AI=true
GOOGLE_API_KEY=
GOOGLE_AI_MODEL=gemma-4-26b-a4b-it
# Optional second model: an HTTP 503/429 or timeout on GOOGLE_AI_MODEL is retried once on this
# model (e.g. gemini-3.1-flash-lite). Empty = no fallback.
GOOGLE_AI_FALLBACK_MODEL=

# Local Ollama (background intelligence). Set to false where Ollama isn't available (e.g. Render).
OLLAMA_ENABLED=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4

# Demo clock: run the app on a simulated date, e.g. DEMO_TODAY=2027-05-05 (Kharif season,
# which the rule base covers). Leave empty to use the real date.
DEMO_TODAY=

# Live demo lock-down. Admin tools (/admin, Refresh Data reseed, /test/ai) are OFF unless "true".
# Keep it unset or false on Render.
DEMO_ADMIN_ENABLED=true

# Minimum seconds between two Weather Change Simulator runs per user (0 = no cooldown).
SIMULATOR_COOLDOWN_SECONDS=30
